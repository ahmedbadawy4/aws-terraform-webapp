# Copy this file to terraform.tfvars and change the values.
# terraform.tfvars is ignored by git.

application = "webapp"
environment = "dev"

# Your own public IP address followed by /32. Only these addresses can reach
# the instance on ports 22 and 80. The value below is a documentation address,
# replace it. Leave the list empty to allow no access from outside the VPC.
allowed_cidr_blocks = ["203.0.113.10/32"]

# Optional, these are the defaults.
# aws_region        = "us-east-1"
# instance_type     = "t3.micro"
# db_instance_class = "db.t3.micro"
